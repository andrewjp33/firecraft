  var dom = fw.getDocumentDOM();
  for (var i = 0; i < cells.length; i++) {
    var x = (i % cols) * cw + 30, y = Math.floor(i / cols) * cw + 30;
    if (i % 2 == 0) dom.addNewOval({left:x, top:y, right:x+70, bottom:y+70}); else dom.addNewRectangle({left:x, top:y, right:x+70, bottom:y+70}, 8);
    dom.setBrush(null); dom.setFillColor("#3d7fc4");
    try { fw.selection[0].name = cells[i].label; } catch (e) {}
    try { dom.applyEffects({category:"Untitled", name:"Untitled", effects:[cells[i].fx]}); } catch (e) { log += cells[i].label + " ERR " + e + "\n"; }
  }
} catch (e) { log += "ERR " + e + "\n"; }
if (log != "") alert(log);